{
  "_comment": "Production Index Settings for ThaiJO Articles (Multi-locale Nested Schema)",
  "searchableAttributes": [
    "titles.th_TH",
    "titles.en_US",
    "abstracts.th_TH",
    "abstracts.en_US",
    "authors.th_TH",
    "authors.en_US",
    "keywords.th_TH",
    "keywords.en_US",
    "doi",
    "journal_path",
    "journal_name.th_TH",
    "journal_name.en_US"
  ],
  "displayedAttributes": [
    "*"
  ],
  "filterableAttributes": [
    "id",
    "journal_id",
    "category",
    "languages",
    "issue_id",
    "journal_path",
    "keywords.th_TH",
    "keywords.en_US",
    {
      "attributePatterns": ["year"],
      "features": {
        "facetSearch": false,
        "filter": {
          "equality": true,
          "comparison": true
        }
      }
    },
    {
      "attributePatterns": ["date_published"],
      "features": {
        "facetSearch": false,
        "filter": {
          "equality": true,
          "comparison": true
        }
      }
    }
  ],
  "sortableAttributes": [
    "date_published",
    "year",
    "seq"
  ],
  "rankingRules": [
    "words",
    "exactness",
    "typo",
    "proximity",
    "attribute",
    "sort"
  ],
  "proximityPrecision": "byWord",
  "stopWords": [
    "และ",
    "หรือ",
    "ใน",
    "ของ",
    "เพื่อ",
    "โดย",
    "จาก",
