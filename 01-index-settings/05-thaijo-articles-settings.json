    "โควิด-19": ["โควิด", "โควิด19", "covid-19", "sars-cov-2"],
    "โควิด19": ["โควิด", "โควิด-19", "covid-19", "sars-cov-2"],
    "covid-19": ["โควิด", "โควิด-19", "โควิด19", "sars-cov-2"],
    "sars-cov-2": ["โควิด", "โควิด-19", "covid-19"],
