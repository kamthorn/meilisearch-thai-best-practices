    "เอไอ": ["ปัญญาประดิษฐ์", "artificial intelligence"],
    "artificial intelligence": ["ปัญญาประดิษฐ์", "เอไอ"],
    "อินเทอร์เน็ตของสรรพสิ่ง": ["iot", "internet of things"],
    "iot": ["อินเทอร์เน็ตของสรรพสิ่ง", "internet of things"],
    "internet of things": ["อินเทอร์เน็ตของสรรพสิ่ง", "iot"],
    "ข้อมูลขนาดใหญ่": ["big data"],
    "big data": ["ข้อมูลขนาดใหญ่"]
  },
  "typoTolerance": {
    "enabled": true,
    "disableOnAttributes": [
      "doi",
      "journal_path"
    ],
    "minWordSizeForTypos": {
      "oneTypo": 6,
      "twoTypos": 10
    },
    "disableOnNumbers": true
  },
  "localizedAttributes": [
    {
      "locales": ["tha"],
      "attributePatterns": [
        "titles.th_TH",
        "abstracts.th_TH",
        "authors.th_TH",
        "keywords.th_TH",
        "journal_name.th_TH"
      ]
    },
    {
      "locales": ["eng"],
      "attributePatterns": [
        "titles.en_US",
        "abstracts.en_US",
        "authors.en_US",
        "keywords.en_US",
        "journal_name.en_US"
      ]
    }
  ],
  "faceting": {
    "maxValuesPerFacet": 10000
  },
  "pagination": {
    "maxTotalHits": 500000
  },
  "searchCutoffMs": 1500
